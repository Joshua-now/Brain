# Brain service environment
DATABASE_URL=            # Railway: set to ${{Postgres.DATABASE_URL}}
MEMORY_API_KEY=          # long random string; every agent uses this to call the brain
OPENROUTER_API_KEY=      # used only by /reflect to distill memories
REFLECT_MODEL=openai/gpt-oss-120b
# PGSSL=off              # only if your Postgres doesn't use SSL (Railway does — leave unset)
